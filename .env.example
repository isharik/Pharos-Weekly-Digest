# Required: generate with `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`
DIGEST_API_TOKEN=replace-with-a-random-secret-at-least-32-characters-long

# SMTP account for scheduled digest email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Pharos Digest <digest@example.com>

# Free API key for Pharos transaction history from developer.socialscan.io
SOCIALSCAN_API_KEY=replace-with-your-socialscan-api-key

# Optional: public URL where the frontend is hosted; dev localhost origins are allowed by default
# WEB_ORIGIN=https://your-frontend.example.com
# PORT=8787
# DIGEST_DATA_FILE=.data/scheduler.json
# VITE_DIGEST_API_URL=https://your-backend.example.com
